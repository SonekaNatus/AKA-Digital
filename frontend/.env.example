# ---------------------------------------------------------------
# Variáveis do frontend (copie para frontend/.env)
# Todas as variáveis VITE_* são embutidas no build: reinicie o
# "npm run dev" ou gere um novo "npm run build" após alterá-las.
# ---------------------------------------------------------------

# URL pública da API. Deixe vazio em desenvolvimento (usa o proxy do Vite).
# Em produção com frontend e backend em domínios diferentes, ex.: https://api.seudominio.com.br
VITE_API_URL=

# Número do WhatsApp comercial com DDI e DDD, somente dígitos. Ex.: 5511900000000
VITE_WHATSAPP_NUMBER=

# Mensagem inicial sugerida nas conversas pelo WhatsApp
VITE_WHATSAPP_MESSAGE=Olá! Vim pelo site da AKA Digital e gostaria de solicitar um orçamento.

# Instagram oficial (deixe vazio para ocultar o link)
VITE_INSTAGRAM_URL=

# E-mail comercial exibido no site (deixe vazio para ocultar)
VITE_CONTACT_EMAIL=

# Endereço público do site (usado em metadados e SEO)
VITE_SITE_URL=http://localhost:5173
