# ---------------------------------------------------------------
# Variáveis de ambiente do backend (copie para backend/.env)
# ---------------------------------------------------------------

# Porta da API
PORT=3001
NODE_ENV=development

# Origens permitidas pelo CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# Servir o frontend compilado (frontend/dist) pelo próprio Express
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../frontend/dist

# Limite de envios do formulário por IP a cada 15 minutos
CONTACT_RATE_LIMIT_MAX=10

# --- E-mail (SMTP) -------------------------------------------
# Deixe SMTP_HOST vazio para desativar o envio de e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido (ex.: "AKA Digital <contato@seudominio.com.br>")
EMAIL_FROM=
# E-mail que receberá os novos pedidos de orçamento
CONTACT_EMAIL_TO=

# --- WhatsApp Cloud API (Meta) -------------------------------
# Deixe vazio para desativar as notificações por WhatsApp.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número (somente dígitos, com DDI) que receberá a notificação
WHATSAPP_NOTIFY_TO=
WHATSAPP_API_VERSION=v21.0
